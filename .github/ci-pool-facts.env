# Canonical, machine-readable facts about the self-hosted CI runner pool.
#
# ONE place, because the alternative was measured: the pool size and the
# per-run job count were stated in prose in six tracked files, checked by
# nothing, and every one of them was wrong (#879). Two of the six were
# operator-facing — the text ci-queue-watchdog.sh prints during a capacity
# incident — so a stale number was actively misdirecting the person reading
# it.
#
# WHAT LIVES HERE AND WHAT DOES NOT.
#
#   pool size          declared here. It cannot be derived from the tree:
#                      listing self-hosted runners needs repo
#                      `administration` rights, and that is NOT one of the
#                      permission scopes a workflow GITHUB_TOKEN can be
#                      granted at all. MEASURED 2026-08-28 with actionlint's
#                      own scope enumeration; see check-pool-facts.sh.
#
#   jobs per run       NOT here. It is DERIVED from
#                      .github/workflows/integration.yml by
#                      scripts/check-pool-facts.sh. A second copy would be a
#                      second answer.
#
# So this file is the weaker half by construction: the number here can still
# disagree with the live pool. What it can no longer do is disagree with the
# prose that quotes it — scripts/check-pool-facts.sh binds every marked site
# in the tracked tree to these values, and refuses if it cannot.
#
# WHEN YOU RESIZE THE POOL: change DHCP_CI_POOL_SIZE and the measured date
# below, then run `bash scripts/check-pool-facts.sh`. It names every prose
# site that now disagrees. Do not correct the prose without correcting this
# file; the gate checks both directions.

# Number of runners registered with the DHCP_CI_POOL_LABEL label.
# MEASURED 2026-08-28 against the live runner list:
# 16 online (pool-facts: pool-size=16), named dhcp-ci-<n>. The arm64
# runner carries a different label and is deliberately not counted here.
#
# That marker is not decoration. This comment is prose like any other and
# would go stale the moment the value below changed, in the one file whose
# whole job is to be the single declaration -- so it is bound to the value
# below by the same check that binds every other site.
DHCP_CI_POOL_SIZE=16
DHCP_CI_POOL_SIZE_MEASURED=2026-08-28

# The label that identifies the amd64 privileged pool. This is what the
# jobs-per-run derivation matches `runs-on:` against, so it is a fact and
# not a comment: change it here and the derivation follows.
DHCP_CI_POOL_LABEL=dhcp-ci

# The workflow whose per-run job count the `jobs-per-run` fact describes.
# Other workflows also place jobs on the pool (coverage, capture-fixtures);
# they are separate runs and are not part of this fact. Named here so the
# gate's domain is a declared fact rather than a constant in the script.
DHCP_CI_JOBS_PER_RUN_WORKFLOW=.github/workflows/integration.yml

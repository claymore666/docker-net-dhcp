# The branch history the CI gates reason about. ONE definition, two readers.
#
# WHY THIS FILE EXISTS (#874). Two scripts have to agree about the same
# population of commits, and they fail in opposite directions:
#
#   scripts/check-missing-runs.sh  READS the run records of the last
#       GATE_BRANCH_COMMITS commits of each GATE_BRANCHES branch, and goes
#       red when a commit has no run that executed.
#
#   scripts/purge-workflow-runs.sh DELETES run records, and its keep rule 5
#       spares exactly that population so the detector still has something
#       to read.
#
# If the purge's idea of the population is SMALLER than the detector's, the
# purge deletes evidence the detector then demands, and the detector goes
# red naming a cause that never happened -- on a schedule, on main, every
# release cycle. That is not hypothetical: it is the same collision that
# #740/#837 already paid for once with open PR heads, arriving through a
# second population nobody had reconciled.
#
# A SECOND ENUMERATION THAT MUST AGREE WITH THE FIRST IS THE DEFECT, NOT
# THE FIX. The obvious repair -- set the same numbers in both workflow
# files -- recreates the bug one edit later, silently, in the direction
# that destroys data. So the numbers live here once and both scripts read
# them. Neither workflow sets them; changing the scope means changing this
# file, and both gates move together or neither does.
#
# The scripts still accept GATE_BRANCHES / GATE_BRANCH_COMMITS from the
# environment, because the self-tests drive those seams. Production sets
# neither.

# Branches whose recent history must stay tested and stay evidenced.
# Empty would disable the detector's branch phase entirely, so it is not
# empty here; the self-tests drive that case through the environment.
GATE_SCOPE_BRANCHES="dev main"

# How far back on each branch. 15 covers a merge burst comfortably at an
# hourly cadence: the 2026-08-13 incident put six runs on dev in twenty
# seconds, and a commit stays in range for well over a day of normal
# traffic. Raising it costs the detector one API call per extra commit and
# widens the purge's keep set by the same commits -- both in the safe
# direction.
GATE_SCOPE_COMMITS=15

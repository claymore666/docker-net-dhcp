{
    "description": "Docker DHCP networking (host-bridge or macvlan attachment)",
    "interface": {
        "socket": "net-dhcp.sock",
        "types": [
            "docker.networkdriver/1.0"
        ]
    },
    "entrypoint": [
        "/usr/sbin/net-dhcp",
        "-logfile",
        "/var/log/net-dhcp.log"
    ],
    "env": [
        {
            "description": "Log level",
            "name": "LOG_LEVEL",
            "value": "info",
            "settable": [
                "value"
            ]
        },
        {
            "description": "Timeout while awaiting container/sandbox readiness",
            "name": "AWAIT_TIMEOUT",
            "value": "10s",
            "settable": [
                "value"
            ]
        },
        {
            "description": "Directory where per-network options are persisted",
            "name": "STATE_DIR",
            "value": "/var/lib/net-dhcp",
            "settable": [
                "value"
            ]
        },
        {
            "description": "How often the DHCP-outage watchdog re-checks; also the resolution of dhcp_timeouts",
            "name": "OUTAGE_TICK",
            "value": "30s",
            "settable": [
                "value"
            ]
        },
        {
            "description": "Settling time before the watchdog reports an outage; must exceed normal lease-acquisition time",
            "name": "OUTAGE_GRACE",
            "value": "25s",
            "settable": [
                "value"
            ]
        },
        {
            "description": "Optional TCP address for the Prometheus /metrics endpoint (e.g. 127.0.0.1:9099); empty means no TCP listener",
            "name": "METRICS_ADDR",
            "value": "",
            "settable": [
                "value"
            ]
        }
    ],
    "workdir": "/",
    "network": {
        "type": "host"
    },
    "pidhost": true,
    "mounts": [
        {
            "source": "/var/run/docker.sock",
            "destination": "/run/docker.sock",
            "type": "bind",
            "options": [
                "bind"
            ]
        },
        {
            "source": "/var/lib/net-dhcp",
            "destination": "/var/lib/net-dhcp",
            "type": "bind",
            "options": [
                "rbind",
                "rw"
            ]
        },
        {
            "source": "/var/run/docker",
            "destination": "/var/run/docker",
            "type": "bind",
            "options": [
                "rbind",
                "ro"
            ]
        }
    ],
    "linux": {
        "capabilities": [
            "CAP_NET_ADMIN",
            "CAP_SYS_ADMIN",
            "CAP_SYS_PTRACE"
        ]
    }
}

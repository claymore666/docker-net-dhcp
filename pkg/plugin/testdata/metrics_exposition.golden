# HELP net_dhcp_build_info Plugin instance identity. The instance_id label changes on every plugin restart, so a counter reset appears as a new series rather than as a rewind.
# TYPE net_dhcp_build_info gauge
net_dhcp_build_info{instance_id="fixture-instance"} 1

# HELP net_dhcp_healthy 1 when the plugin reports itself healthy, 0 when an operator should look. Mirrors the healthy field of /Plugin.Health.
# TYPE net_dhcp_healthy gauge
net_dhcp_healthy 1

# HELP net_dhcp_uptime_seconds Seconds since this plugin process started.
# TYPE net_dhcp_uptime_seconds gauge
